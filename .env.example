# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored. .env.example is committed (no secrets here).
# =============================================================================

# --- Database ---
# Dev DB: used by the running app and the seed script
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_investigator

# Test DB: used ONLY by pytest. Never run the seed script against this.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_investigator_test

# --- LLM: Runtime (answering user queries — free/cheap model) ---
RUNTIME_LLM_PROVIDER=groq
RUNTIME_LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=your-groq-api-key-here

# --- LLM: Judge (RAGAS evaluation only — Phase 2+, paid model) ---
JUDGE_LLM_PROVIDER=openai
JUDGE_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# --- Optional: Gemini (alternative runtime provider) ---
# RUNTIME_LLM_PROVIDER=gemini
# RUNTIME_LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=your-gemini-api-key-here

# --- Seed script ---
API_BASE_URL=http://localhost:8000
